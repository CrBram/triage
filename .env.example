# --- AI model -----------------------------------------------------------------
# Mastra model router string: provider/model. The matching provider key must be set.
# Examples: google/gemini-3.6-flash, google/gemini-3.1-pro-preview, openai/gpt-5.4-mini, anthropic/claude-sonnet-4-6
# Full list per provider: https://mastra.ai/models
TRIAGE_MODEL=google/gemini-3.6-flash
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Database (triage sessions, conversation threads) -------------------------
# Local development: SQLite file (default when unset).
DATABASE_URL=file:./triage.db
# Hosted (e.g. Turso): libsql://<db>.turso.io plus an auth token.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
