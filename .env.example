# --- AI model -----------------------------------------------------------------
# Mastra model router string: provider/model. The matching provider key must be set.
# Examples: google/gemini-3.1-flash-lite, google/gemini-3.6-flash, openai/gpt-5.4-mini, anthropic/claude-sonnet-4-6
# Full list per provider: https://mastra.ai/models
# Note: gemini-3.1-flash-lite has the most generous Google free-tier quota (500 req/day vs 20 for other Gemini models).
TRIAGE_MODEL=google/gemini-3.1-flash-lite
# Ordered fallbacks used when the primary model is overloaded (5xx) or rate limited.
TRIAGE_FALLBACK_MODELS=google/gemini-3.5-flash-lite,google/gemini-3-flash-preview
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Database (triage sessions, conversation threads) -------------------------
# Local development: SQLite file (default when unset).
DATABASE_URL=file:./triage.db
# Hosted (e.g. Turso): libsql://<db>.turso.io plus an auth token.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
